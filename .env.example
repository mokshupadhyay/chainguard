# ---- Deployer: use an encrypted Foundry keystore, NOT a raw key in this file ----
#   cast wallet import chainguard-deployer --interactive     (type the testnet-only key into your terminal)
DEPLOYER_ACCOUNT=chainguard-deployer
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER_PUBLIC_ADDRESS
# optional: file (outside the repo, chmod 600) holding the keystore password, to avoid repeated prompts
KEYSTORE_PASSWORD_FILE=

# ---- Chains ----
BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com  # sepolia.base.org caps eth_getLogs at 200 blocks; do not use it for indexing
LASNA_RPC=https://lasna-rpc.rnk.dev/

# ---- Deployed addresses (fill after deploy) ----
MOCK_ERC20=
CHAINGUARD_REACTIVE=
GUARD_FACTORY=

# ---- Backend (Render) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
CORS_ORIGIN=http://localhost:5173
PORT=8787

# ---- Frontend (public values only) ----
VITE_API_URL=http://localhost:8787
VITE_BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com
VITE_MOCK_ERC20=
VITE_GUARD_FACTORY=
VITE_CHAINGUARD_REACTIVE=
